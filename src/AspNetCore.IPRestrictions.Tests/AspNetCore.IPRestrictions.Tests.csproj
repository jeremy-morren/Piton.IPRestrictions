<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(IPRestrictionsTargetFrameworks)</TargetFrameworks>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <OutputType>Exe</OutputType>
        <IsTestProject>true</IsTestProject>
        <IsPackage>false</IsPackage>
        
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\AspNetCore.IPRestrictions.Endpoints\AspNetCore.IPRestrictions.Endpoints.csproj" />
        <ProjectReference Include="..\AspNetCore.IPRestrictions.Endpoints.Telemetry\AspNetCore.IPRestrictions.Endpoints.Telemetry.csproj" />
    </ItemGroup>

    <!-- The patched OpenTelemetry (GHSA-g94r-2vxg-569j) where available: as in the Telemetry project -->
    <PropertyGroup>
        <OpenTelemetryVersion Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">1.15.3</OpenTelemetryVersion>
        <OpenTelemetryVersion Condition="'$(OpenTelemetryVersion)' == ''">1.9.0</OpenTelemetryVersion>
    </PropertyGroup>

    <ItemGroup>
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-g94r-2vxg-569j" />
        <PackageReference Include="OpenTelemetry" Version="$(OpenTelemetryVersion)" />
        <PackageReference Include="OpenTelemetry.Exporter.InMemory" Version="$(OpenTelemetryVersion)" />
        <!-- services.AddOpenTelemetry(), for AddIPRestrictionsInstrumentation(configure) -->
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="$(OpenTelemetryVersion)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="6.0.4"/>
        <PackageReference Include="FluentAssertions" Version="8.11.0" />
        <!-- Last versions supporting net6.0 (xunit.v3 2.0, xunit.runner.visualstudio 3.1 and Microsoft.NET.Test.Sdk 17.14 require net8.0) -->
        <PackageReference Include="xunit.v3" Version="1.1.0" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    </ItemGroup>

    <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <DotnetPackageVersion>10.0.14</DotnetPackageVersion>
        <ExtensionsPackageVersion>10.0.14</ExtensionsPackageVersion>
    </PropertyGroup>
    <PropertyGroup Condition="'$(TargetFramework)' == 'net9.0'">
        <DotnetPackageVersion>9.0.22</DotnetPackageVersion>
        <ExtensionsPackageVersion>9.0.22</ExtensionsPackageVersion>
    </PropertyGroup>
    <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
        <DotnetPackageVersion>8.0.33</DotnetPackageVersion>
        <ExtensionsPackageVersion>8.0.2</ExtensionsPackageVersion>
    </PropertyGroup>
    <!-- Extensions 8.0 on net6.0/net7.0: OpenTelemetry 1.9.0 depends on Microsoft.Extensions.* 8.0 (a lower version is a downgrade error) -->
    <PropertyGroup Condition="'$(TargetFramework)' == 'net7.0'">
        <DotnetPackageVersion>7.0.20</DotnetPackageVersion>
        <ExtensionsPackageVersion>8.0.2</ExtensionsPackageVersion>
    </PropertyGroup>
    <PropertyGroup Condition="'$(TargetFramework)' == 'net6.0'">
        <DotnetPackageVersion>6.0.20</DotnetPackageVersion>
        <ExtensionsPackageVersion>8.0.2</ExtensionsPackageVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="$(DotnetPackageVersion)" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="$(ExtensionsPackageVersion)" />
    </ItemGroup>

</Project>
