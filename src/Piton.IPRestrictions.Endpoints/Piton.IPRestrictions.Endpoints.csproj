<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFrameworks>$(IPRestrictionsTargetFrameworks)</TargetFrameworks>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <OutputType>library</OutputType>
        <LangVersion>14</LangVersion>
        
        <IsPackable>true</IsPackable>
        
        <PackageId>Piton.IPRestrictions.Endpoints</PackageId>
    </PropertyGroup>
    
    <ItemGroup>
        <InternalsVisibleTo Include="Piton.IPRestrictions.Tests"/>
    </ItemGroup>

    <!-- .NET8+: enable native AOT and configuration binding source generator -->
    <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
        <!-- Also sets IsTrimmable, and enables the trim, AOT and single-file analyzers -->
        <IsAotCompatible>true</IsAotCompatible>
        <!-- Replaces the reflection-based BindConfiguration with generated code -->
        <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    </PropertyGroup>

    <!--
        Before .NET 8: IMeterFactory (DiagnosticSource) and AddMetrics (Extensions.Diagnostics)
    -->
    <ItemGroup Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
        <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="8.0.0" />
        <PackageReference Include="Microsoft.Extensions.Diagnostics" Version="8.0.0" />
    </ItemGroup>
</Project>