<Project>
    <PropertyGroup>
        <LangVersion>14</LangVersion>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
        
        <UseArtifactsOutput>true</UseArtifactsOutput>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>

        <PackageReadmeFile>README.md</PackageReadmeFile>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>

        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>

        <!-- 
            NET 6: The floor.
            NET 7: Middleware properties added, enabling checking whether UseRouting() and UseAuthentication() are called.
            NET 8: AOT and configuration binding source generator, forwarded headers proxy detection
            NET 9: Static web assets
            NET 10: ForwardedHeaderOptions.KnownIPNetworks replaced KnownNetworks
        -->
        <IPRestrictionsTargetFrameworks>net6.0;net7.0;net8.0;net9.0;net10.0</IPRestrictionsTargetFrameworks>
        <CheckEolTargetFramework>false</CheckEolTargetFramework>
    </PropertyGroup>

    <!-- Strong naming: every assembly in the repo is signed with the same key -->
    <PropertyGroup>
        <SignAssembly>true</SignAssembly>
        <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)Piton.IPRestrictions.snk</AssemblyOriginatorKeyFile>
    </PropertyGroup>

    <PropertyGroup>
        <Authors>Jeremy Morren</Authors>
        <Copyright>Copyright © Jeremy Morren 2026</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Description>A middleware that provides per-endpoint IP restrictions (safelist). It can be configured using single IP address or ranges, and supports a predicate to allow for more complex filtering</Description>

        <PackageTags>aspnetcore;aspnetcoremvc;middleware;filter;filtering;ip;ipfiltering;ipfilter;ASP.NET;MVC;whitelist;blacklist;netcore</PackageTags>
        <PackageTags>
            aspnetcore;aspnet;asp.net;mvc;netcore;
            middleware;endpoint;endpoints;minimal-api;
            middleware;filter;filtering;ip;ipfiltering;ipfilter;ipblocking;
            safelist;denylist;allowlist;blocklist;whitelist;blacklist;
            x-forwarded-for;reverse-proxy
        </PackageTags>
        
        <PackageProjectUrl>https://github.com/jeremy-morren/Piton.IPRestrictions</PackageProjectUrl>
        <RepositoryUrl>https://github.com/jeremy-morren/Piton.IPRestrictions</RepositoryUrl>
        <RepositoryType>git</RepositoryType>

        <!-- The Pitons of St Lucia: generated by assets/generate-icon.py -->
        <PackageIcon>icon.png</PackageIcon>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)../README.md"
              Pack="true" PackagePath=""
              Visible="false" />
        <None Include="$(MSBuildThisFileDirectory)../assets/icon.png"
              Pack="true" PackagePath=""
              Visible="false" />
    </ItemGroup>
    
    <ItemGroup>
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.115" PrivateAssets="All"/>
    </ItemGroup>

    <Import Project="$(MSBuildThisFileDirectory)version.props" />
</Project>