<Project>
    <PropertyGroup>
        <LangVersion>14</LangVersion>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
        
        <UseArtifactsOutput>true</UseArtifactsOutput>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>

        <PackageReadmeFile>README.md</PackageReadmeFile>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        
        <CheckEolTargetFramework>false</CheckEolTargetFramework>
        <IPRestrictionsTargetFrameworks>net7.0;net9.0;net10.0</IPRestrictionsTargetFrameworks>
    </PropertyGroup>

    <!-- Strong naming: every assembly in the repo is signed with the same key -->
    <PropertyGroup>
        <SignAssembly>true</SignAssembly>
        <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)AspNetCore.IPRestrictions.snk</AssemblyOriginatorKeyFile>
    </PropertyGroup>

    <PropertyGroup>
        <Authors>Jeremy Morren</Authors>
        <Copyright>Copyright © Jeremy Morren 2026</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)../README.md" 
              Pack="true" PackagePath="" 
              Visible="false" />
    </ItemGroup>

    <Import Project="$(MSBuildThisFileDirectory)version.props" />
</Project>