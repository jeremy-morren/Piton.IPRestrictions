<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFrameworks>$(IPRestrictionsTargetFrameworks)</TargetFrameworks>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <OutputType>library</OutputType>
        <LangVersion>14</LangVersion>
        
        <IsPackable>true</IsPackable>
        
        <PackageId>AspNetCore.IPRestrictions.Endpoints</PackageId>
    </PropertyGroup>
    
    <ItemGroup>
        <InternalsVisibleTo Include="AspNetCore.IPRestrictions.Tests"/>
    </ItemGroup>

    <!-- Native AOT for ASP.NET Core starts at .NET 8, as does the configuration binding source generator -->
    <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
        <!-- Also sets IsTrimmable, and enables the trim, AOT and single-file analyzers -->
        <IsAotCompatible>true</IsAotCompatible>
        <!-- Replaces the reflection-based BindConfiguration with generated code -->
        <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    </PropertyGroup>
</Project>