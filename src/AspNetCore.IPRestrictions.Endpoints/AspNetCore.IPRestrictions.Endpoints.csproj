<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFrameworks>$(IPRestrictionsTargetFrameworks)</TargetFrameworks>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <OutputType>library</OutputType>
        <LangVersion>14</LangVersion>
        
        <IsPackable>true</IsPackable>
    </PropertyGroup>
    
    <PropertyGroup>
        <PackageId>AspNetCore.IPRestrictions.Endpoints</PackageId>
        <Description>A middleware that provides per-endpoint IP restrictions (safelist). It can be configured using single IP address or ranges, and supports a predicate to allow for more complex filtering</Description>
    </PropertyGroup>
    
    <ItemGroup>
        <InternalsVisibleTo Include="AspNetCore.IPRestrictions.Tests"/>
    </ItemGroup>
</Project>